# Nexus — Personal AI Command Center
# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (Docker Compose default below)
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus

# Long random string used to encrypt stored API keys (AES-256-GCM).
# Generate: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=change-me-to-a-long-random-string

# App port (Docker maps this)
PORT=3000

# Optional: override workspace root (project file sandbox)
# WORKSPACE_ROOT=./data/workspaces
